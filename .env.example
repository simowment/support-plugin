# =============================================================================
# Support Tickets Plugin: environment fallbacks
#
# Every value below can instead be passed as a module option in medusa-config.ts
# (see README "Configuration"). The plugin reads these variables only when the
# matching option is unset. Put them in your Medusa backend's .env file.
# =============================================================================

# Optional Discord-compatible webhook for new tickets, customer replies, closures
# and AI escalations. Option: discord_webhook_url (support-ticket module).
DISCORD_WEBHOOK_URL=

# Mailgun inbound email (POST /hooks/mailgun/inbound). Disabled unless "true".
# Options: mailgun_inbound_enabled, mailgun_webhook_signing_key,
# inbound_recipients, reply_email_domain (support-ticket module).
SUPPORT_MAILGUN_INBOUND_ENABLED=false
MAILGUN_WEBHOOK_SIGNING_KEY=
# Comma-separated mailbox addresses that open new tickets, e.g. support@example.com
SUPPORT_INBOUND_RECIPIENTS=
# Domain for guest reply addresses (reply+<token>@<domain>), e.g. reply.example.com
SUPPORT_REPLY_EMAIL_DOMAIN=

# Required before AI provider API keys can be saved from (or read back into) the
# Admin UI. Use a high-entropy secret; the plugin derives an AES-256-GCM key from it.
# Option: api_key_encryption_key (ai module).
SUPPORT_TICKET_AI_KEY_ENCRYPTION_KEY=

# The AI fallback credentials (openai_api_key, openai_model, openai_base_url,
# openai_headers) are module options only; the plugin does not read AI provider
# environment variables itself. Map your own variables to them in medusa-config.ts.

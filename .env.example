# =============================================================================
# Support Tickets Plugin — Environment Configuration
#
# These variables are consumed by the parent backend/.env.
# Use backend/.env.dev or backend/.env.prod instead.
# =============================================================================

# Optional Discord notifications for new tickets and customer replies.
DISCORD_WEBHOOK_URL=

# Optional AI provider overrides (can also be set via Admin UI at runtime).
# These take precedence over database-stored settings.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=

# Required before storing AI provider API keys from the Admin UI.
# Use a high-entropy secret; the plugin derives the AES-256-GCM key from it.
SUPPORT_TICKET_AI_KEY_ENCRYPTION_KEY=

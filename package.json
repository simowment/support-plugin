{
  "name": "@medusastore/medusa-plugin-support-tickets",
  "version": "0.0.1",
  "description": "Customer support tickets for Medusa v2: store and admin APIs, admin inbox, Mailgun inbound email, guest email replies and optional AI triage.",
  "main": ".medusa/server/src/index.js",
  "types": ".medusa/server/src/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/simowment/support-plugin.git"
  },
  "bugs": {
    "url": "https://github.com/simowment/support-plugin/issues"
  },
  "homepage": "https://github.com/simowment/support-plugin#readme",
  "exports": {
    "./package.json": "./package.json",
    "./.medusa/server/src/*": "./.medusa/server/src/*.js",
    "./.medusa/server/src/modules/*": "./.medusa/server/src/modules/*/index.js",
    "./workflows/*": {
      "types": "./.medusa/server/src/workflows/*.d.ts",
      "import": "./.medusa/server/src/workflows/*.js",
      "require": "./.medusa/server/src/workflows/*.js",
      "default": "./.medusa/server/src/workflows/*.js"
    },
    "./modules/*": {
      "types": "./.medusa/server/src/modules/*/index.d.ts",
      "import": "./.medusa/server/src/modules/*/index.js",
      "require": "./.medusa/server/src/modules/*/index.js",
      "default": "./.medusa/server/src/modules/*/index.js"
    },
    "./admin": {
      "import": "./.medusa/server/src/admin/index.mjs",
      "require": "./.medusa/server/src/admin/index.js",
      "default": "./.medusa/server/src/admin/index.js"
    },
    "./*": "./.medusa/server/src/*.js",
    ".": {
      "types": "./.medusa/server/src/index.d.ts",
      "import": "./.medusa/server/src/index.js",
      "require": "./.medusa/server/src/index.js",
      "default": "./.medusa/server/src/index.js"
    }
  },
  "files": [
    ".medusa/server",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "medusa plugin:build && tsc",
    "prepack": "corepack pnpm build",
    "prepublishOnly": "corepack pnpm build",
    "dev": "medusa plugin:develop",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\""
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.61",
    "@medusajs/admin-sdk": "2.21.2",
    "@medusajs/js-sdk": "2.21.2",
    "@medusajs/icons": "^2.21.2",
    "@medusajs/ui": "^4.1.15",
    "ai": "^6.0.175",
    "multer": "^2.0.2",
    "zod": "^3.24.0"
  },
  "peerDependencies": {
    "@medusajs/core-flows": "2.21.2",
    "@medusajs/framework": "2.21.2",
    "@medusajs/medusa": "2.21.2",
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "devDependencies": {
    "@medusajs/cli": "2.21.2",
    "@swc/core": "^1.15.26",
    "@types/multer": "^2.1.0",
    "@types/react": "^18.3.2",
    "@types/react-dom": "^18.2.25",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "medusa-plugin",
    "medusa-v2",
    "medusa",
    "support-tickets",
    "customer-support",
    "helpdesk",
    "mailgun",
    "ai"
  ],
  "license": "MIT",
  "author": "simowment",
  "engines": {
    "node": ">=20.19.0"
  }
}

{
  "name": "@medusastore/medusa-plugin-support-tickets",
  "version": "0.0.1",
  "description": "Medusa v2 plugin for customer support tickets",
  "main": ".medusa/server/src/index.js",
  "types": ".medusa/server/src/index.d.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/simowment/support-plugin.git"
  },
  "bugs": {
    "url": "https://github.com/simowment/support-plugin/issues"
  },
  "homepage": "https://github.com/simowment/support-plugin#readme",
  "exports": {
    "./package.json": "./package.json",
    "./modules/*": "./.medusa/server/src/modules/*/index.js",
    "./providers/*": "./.medusa/server/src/providers/*/index.js",
    "./.medusa/server/src/modules/*": "./.medusa/server/src/modules/*/index.js",
    "./.medusa/server/src/*": "./.medusa/server/src/*.js",
    "./admin": {
      "import": "./.medusa/server/src/admin/index.mjs",
      "require": "./.medusa/server/src/admin/index.js",
      "default": "./.medusa/server/src/admin/index.js"
    },
    "./*": "./.medusa/server/src/*.js",
    ".": {
      "types": "./.medusa/server/src/index.d.ts",
      "import": "./.medusa/server/src/index.js",
      "require": "./.medusa/server/src/index.js",
      "default": "./.medusa/server/src/index.js"
    }
  },
  "files": [
    ".medusa/server"
  ],
  "scripts": {
    "build": "medusa plugin:build && tsc",
    "dev": "medusa plugin:develop",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\"",
    "watch": "tsc --watch --preserveWatchOutput",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@medusajs/core-flows": "^2.13.0",
    "@medusajs/framework": "^2.13.0",
    "@medusajs/medusa": "^2.13.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "devDependencies": {
    "@medusajs/cli": "^2.13.0",
    "@swc/core": "^1.15.26",
    "@types/multer": "^2.1.0",
    "@types/react": "^18.3.2",
    "@types/react-dom": "^18.2.25",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "medusa-plugin",
    "medusa-v2",
    "support-tickets",
    "customer-support"
  ],
  "license": "MIT",
  "author": "igottamakeit",
  "engines": {
    "node": ">=20"
  }
}
